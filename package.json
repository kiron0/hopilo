{
  "name": "hopilo",
  "version": "0.1.6",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter @hopilo/desktop tauri dev",
    "build": "node scripts/build.mjs",
    "typecheck": "pnpm --filter @hopilo/desktop typecheck && pnpm --filter @hopilo/extension typecheck",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all -- --check",
    "test": "cargo test --workspace && pnpm --filter @hopilo/desktop test && pnpm --filter @hopilo/extension test",
    "clean": "node scripts/clean.mjs",
    "ship": "node scripts/ship.mjs",
    "start": "node scripts/ship.mjs",
    "bump": "node scripts/bump-version.mjs"
  }
}
