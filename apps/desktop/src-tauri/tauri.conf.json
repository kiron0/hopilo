{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopilo",
  "mainBinaryName": "Hopilo",
  "version": "0.1.0",
  "identifier": "dev.hopilo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hopilo",
        "width": 1180,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 760,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "maxWidth": 1720,
        "maxHeight": 1120
      },
      {
        "label": "quick",
        "title": "Hopilo",
        "url": "index.html?surface=quick",
        "width": 368,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Universal AI Session Handoff",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
