{
  "manifest_version": 3,
  "name": "Hopilo",
  "short_name": "Hopilo",
  "version": "0.1.6",
  "description": "Capture AI chats into Hopilo and insert Context Packs as reviewable drafts. Never sends messages for you.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://www.claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://assets.grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hopilo",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://www.claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
